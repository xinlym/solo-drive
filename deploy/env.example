# Replace with the HTTPS origin used by the browser; do not append a path.
SOLODRIVE_PUBLIC_URL=https://drive.example.com
SOLODRIVE_ADMIN_USER=admin
SOLODRIVE_COOKIE_SECURE=true
SOLODRIVE_RESERVE_BYTES=5368709120
SOLODRIVE_SESSION_HOURS=168
# Trust only the proxy sources that reach the application; narrow for your network.
SOLODRIVE_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# Only used by the optional standalone Caddy deployment.
SOLODRIVE_DOMAIN=drive.example.com
